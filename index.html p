            const features = document.getElementById('pFeaturesInput').value.split(',').map(s => s.trim()).filter(Boolean);
            const tech = document.getElementById('pTechInput').value.split(',').map(s => s.trim()).filter(Boolean);

            if (editId) {
                // Update existing project
                const index = projectsList.findIndex(p => p.id === editId);
                if (index !== -1) {
                    projectsList[index] = { id: editId, title, category, badge, image, desc, features, tech };
