        /* MEMORY GAME LOGIC & AUDIO SYSTEM */
        const EMOJI_SETS = ['🚀', '🔮', '🎭', '👑', '⚔️', '🐉']; // 6 pairs = 12 cards (4x3 grid)
        let gameCards = [];
        let flippedCards = [];
        let matchedPairs = 0;
        let gameMoves = 0;
        let gameLocked = false;
        let gameAudioEnabled = true;

        // Web Audio Synthesizer for retro sounds
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (!gameAudioEnabled) return;
            try {
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'flip') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(300, now);
                    osc.frequency.exponentialRampToValueAtTime(500, now + 0.08);
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'match') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'win') {
                    [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.type = 'sine';
                        o.frequency.value = freq;
                        g.gain.setValueAtTime(0.2, now + idx * 0.1);
                        g.gain.linearRampToValueAtTime(0.01, now + idx * 0.1 + 0.2);
                        o.start(now + idx * 0.1);
                        o.stop(now + idx * 0.1 + 0.2);
                    });
                }
            } catch (e) {
                console.log('Audio Context Error:', e);
            }
        }

        function toggleGameAudio() {
            gameAudioEnabled = !gameAudioEnabled;
            const icon = document.getElementById('audioIcon');
            if (gameAudioEnabled) {
                icon.className = "fa-solid fa-volume-high text-indigo-400";
            } else {
                icon.className = "fa-solid fa-volume-xmark text-slate-500";
            }
        }

        function openMemoryGameModal() {
            document.getElementById('memoryGameModal').classList.remove('hidden');
            loadGameRecord();
            if (gameCards.length === 0) {
                resetMemoryGame();
            }
        }

        function closeMemoryGameModal() {
            document.getElementById('memoryGameModal').classList.add('hidden');
        }

        function loadGameRecord() {
            const savedRecord = localStorage.getItem('audy_memory_record');
            document.getElementById('gameRecord').textContent = savedRecord ? savedRecord : '-';
        }

        function resetMemoryGame() {
            document.getElementById('gameWinOverlay').classList.add('hidden');
            gameMoves = 0;
            matchedPairs = 0;
            flippedCards = [];
            gameLocked = false;
            document.getElementById('gameMoves').textContent = '0';

            // Duplicate emojis to form pairs & shuffle
            const deck = [...EMOJI_SETS, ...EMOJI_SETS];
            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }

            gameCards = deck.map((emoji, index) => ({
                id: index,
                emoji: emoji,
                isFlipped: false,
                isMatched: false
            }));

            renderMemoryCards();
        }

        function renderMemoryCards() {
            const container = document.getElementById('memoryCardsGrid');
            container.innerHTML = '';

            gameCards.forEach((card, index) => {
                const cardEl = document.createElement('div');
                cardEl.className = "card-perspective h-20 sm:h-28 w-full";
                
                cardEl.innerHTML = `
                    <div id="cardInner_${index}" onclick="handleCardClick(${index})" class="card-inner cursor-pointer ${card.isFlipped ? 'flipped' : ''}">
                        <!-- FRONT FACE (REVEALED EMOJI) -->
                        <div class="card-front flex items-center justify-center text-2xl sm:text-4xl border border-indigo-400/40 rounded-2xl shadow-lg">
                            ${card.emoji}
                        </div>

                        <!-- BACK FACE (PATTERNTED WITH SPARKLE STAR ✦) -->
                        <div class="card-back card-back-pattern rounded-2xl flex items-center justify-center border border-indigo-500/30 hover:border-purple-400/60 transition-all hover:scale-[1.02]">
                            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-indigo-200/90 drop-shadow-[0_0_8px_rgba(165,180,252,0.8)]" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                            </svg>
                        </div>
                    </div>
                `;
                container.appendChild(cardEl);
            });
        }

        function handleCardClick(index) {
            const card = gameCards[index];
            if (gameLocked || card.isFlipped || card.isMatched) return;

            // Flip card
            card.isFlipped = true;
            flippedCards.push(index);
            
            const cardInner = document.getElementById(`cardInner_${index}`);
            cardInner.classList.add('flipped');
            playSound('flip');

            if (flippedCards.length === 2) {
                gameMoves++;
                document.getElementById('gameMoves').textContent = gameMoves;
                checkMatch();
            }
        }

        function checkMatch() {
            gameLocked = true;
            const [idx1, idx2] = flippedCards;
            const card1 = gameCards[idx1];
            const card2 = gameCards[idx2];

            if (card1.emoji === card2.emoji) {
                // Match found
                card1.isMatched = true;
                card2.isMatched = true;
                matchedPairs++;
                flippedCards = [];
                gameLocked = false;
                playSound('match');

                if (matchedPairs === EMOJI_SETS.length) {
                    // Win game!
                    setTimeout(() => {
                        handleGameWin();
                    }, 500);
                }
            } else {
                // Not match -> flip back after delay
                setTimeout(() => {
                    card1.isFlipped = false;
                    card2.isFlipped = false;
                    document.getElementById(`cardInner_${idx1}`).classList.remove('flipped');
                    document.getElementById(`cardInner_${idx2}`).classList.remove('flipped');
                    flippedCards = [];
                    gameLocked = false;
                }, 900);
            }
        }

        function handleGameWin() {
            playSound('win');
            const currentRecord = localStorage.getItem('audy_memory_record');
            if (!currentRecord || gameMoves < parseInt(currentRecord)) {
                localStorage.setItem('audy_memory_record', gameMoves);
                loadGameRecord();
            }

            document.getElementById('winStatsText').textContent = \`Kamu berhasil mencocokkan semua kartu dalam \${gameMoves} langkah!\`;
            document.getElementById('gameWinOverlay').classList.remove('hidden');
        }

        let ttcBoard = ['', '', '', '', '', '', '', '', ''];
        let ttcCurrentPlayer = '❌';
        let ttcGameActive = false;

        function openNewGameModal() {
            document.getElementById('newGameModal').classList.remove('hidden');
            if (!ttcGameActive && ttcBoard.every(cell => cell === '')) {
                resetNewGame();
            }
        }

        function closeNewGameModal() {
            document.getElementById('newGameModal').classList.add('hidden');
        }

        function renderTtcBoard() {
            const boardEl = document.getElementById('ttcBoard');
            boardEl.innerHTML = '';
            ttcBoard.forEach((cell, index) => {
                const btn = document.createElement('button');
                btn.className = "w-20 h-20 sm:w-24 sm:h-24 bg-slate-800/80 hover:bg-slate-700 border border-slate-600 rounded-2xl text-4xl flex items-center justify-center transition-all focus:outline-none shadow-md";
                if(cell === '❌') btn.classList.add('text-pink-500');
                if(cell === '⭕') btn.classList.add('text-cyan-400');
                btn.textContent = cell;
                btn.onclick = () => handleTtcClick(index);
                boardEl.appendChild(btn);
            });
        }

        function handleTtcClick(index) {
            if (ttcBoard[index] !== '' || !ttcGameActive) return;
            
            ttcBoard[index] = ttcCurrentPlayer;
            playSound('flip');
            renderTtcBoard();
            checkTtcWin();
        }

        function checkTtcWin() {
            const winConditions = [
                [0, 1, 2], [3, 4, 5], [6, 7, 8], // Baris
                [0, 3, 6], [1, 4, 7], [2, 5, 8], // Kolom
                [0, 4, 8], [2, 4, 6]             // Diagonal
            ];

            let roundWon = false;
            for (let i = 0; i < winConditions.length; i++) {
                const [a, b, c] = winConditions[i];
                if (ttcBoard[a] && ttcBoard[a] === ttcBoard[b] && ttcBoard[a] === ttcBoard[c]) {
                    roundWon = true;
                    break;
                }
            }

            const resultEl = document.getElementById('ttcResult');
            const turnEl = document.getElementById('ttcTurn');

            if (roundWon) {
                ttcGameActive = false;
                resultEl.textContent = \`🎉 \${ttcCurrentPlayer} Menang! 🎉\`;
                resultEl.classList.remove('hidden');
                playSound('win');
                return;
            }

            if (!ttcBoard.includes('')) {
                ttcGameActive = false;
                resultEl.textContent = "🤝 Permainan Seri!";
                resultEl.classList.remove('hidden');
                return;
            }

            ttcCurrentPlayer = ttcCurrentPlayer === '❌' ? '⭕' : '❌';
            turnEl.textContent = ttcCurrentPlayer;
        }

        function resetNewGame() {
            ttcBoard = ['', '', '', '', '', '', '', '', ''];
            ttcCurrentPlayer = '❌';
            ttcGameActive = true;
            document.getElementById('ttcResult').classList.add('hidden');
            document.getElementById('ttcTurn').textContent = ttcCurrentPlayer;
            renderTtcBoard();
        }

        /* INITIALIZE ON LOAD */
        window.onload = function() {
            renderProjects();
            renderCDramas();
            updateUnreadMessagesCount();
        };
    </script>
